+import { Link } from "@tanstack/react-router";
+
+/**
+ * Not-found view for the programmatic listing routes (/buy-now/<slug>,
+ * /make/<make>, /body-type/<type>, /buy/<model>/<country>).
+ *
+ * A route needs its own notFoundComponent for its head() to apply: without one
+ * the 404 bubbles to the root, which renders the site-wide title with
+ * index,follow. With it, the route's noindex head is served on the 404.
+ */
+export function ProgrammaticNotFound({ what }: { what: string }) {
+  return (
+    <div className="min-h-screen flex items-center justify-center bg-background text-foreground">
+      <div className="text-center px-5">
+        <h1 className="text-3xl font-semibold mb-3">{what} not found</h1>
+        <p className="text-muted-foreground mb-6">It may have been sold or renamed.</p>
+        <div className="flex flex-wrap justify-center gap-3">
+          <Link to="/buy-now" className="btn-gold inline-flex">
+            Cars for sale
+          </Link>
+          <Link to="/cars" className="btn-outline inline-flex">
+            Every model we export
+          </Link>
+        </div>
+      </div>
+    </div>
+  );
+}
