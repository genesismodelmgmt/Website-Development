+ * Per-destination facts: geography, port, paperwork language, main cities and
+ * one routing sentence for each of the sixteen destinations.
+ *
+ * Moved here unchanged from routes/ship-to.$country.tsx so the model-in-country
+ * pages (/buy/<model>/<country>) can draw on the same verified facts instead of
+ * repeating one sentence with the country name swapped. The discipline is the
+ * one stated on the destination pages: geography and the routing that follows
+ * from it, nothing about LWD Africa's facilities, prices or volumes.
+ */
+import { COUNTRIES, type CountryMeta } from "@/lib/countries";
+
+export type Geography = "coastal" | "landlocked" | "island";
+
+export interface CountryProfile {
+  geography: Geography;
+  /** Short port name for the <title>, where the full string is too long. */
+  portShort: string;
+  /** The port city on its own, used to work out which corridors run through it. */
+  portCity: string;
+  /** Language the destination paperwork is written in. */
+  language: string;
+  /** Largest cities, named only as examples of where delivery runs to. */
+  cities: string[];
+  /** One sentence of routing detail specific to this destination. */
+  note: string;
+}
