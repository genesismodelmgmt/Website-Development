diff --git a/src/lib/seo-content/buy-landing-copy.ts b/src/lib/seo-content/buy-landing-copy.ts
new file mode 100644
index 0000000..87ce6d9
--- /dev/null
+++ b/src/lib/seo-content/buy-landing-copy.ts
@@ -0,0 +1,138 @@
+/**
+ * Copy for the model-in-country pages (/buy/<model>/<country>).
+ *
+ * Search intent: "buy a <model> in <country>" / "<model> price in <country>".
+ * The model page (/cars/<model>) owns the model; the destination page
+ * (/ship-to/<country>) owns the route; this page exists only for the
+ * combination, so everything on it has to be about the combination: which of
+ * this model's listings suit this destination, how they reach this port, what
+ * happens at this border, and where delivery runs to.
+ *
+ * Measured before this rewrite: two pages for the same model in different
+ * countries were 0.768 similar on three-word shingles (the country name was
+ * the only thing that changed), which is the shape of a doorway page.
+ *
+ * Every sentence is assembled from data already published on the site: the
+ * model record, its listings, the country record and the destination profile
+ * (port, cities, paperwork language, routing note). No prices, transit times
+ * beyond the published figure, duty rates, stock counts or claims about LWD
+ * Africa's facilities are introduced here.
+ */
+import type { Car } from "@/lib/data";
+import type { CountryMeta } from "@/lib/countries";
+import { ORIGIN_LABEL } from "@/lib/freight";
+import type { ResolvedOrderNowListing } from "@/lib/order-now";
+import { corridorPartners, profileOf, type CountryProfile } from "./country-profiles";
+import { commaAnd, fitDescription, fitTitle, plural } from "./text";
+import { conditionPhrase, distinct, gradeList } from "./listings";
+
+const ORIGIN_SHORT: Record<string, string> = {
+  UK: "the UK",
+  EU: "Europe",
+  UAE: "the UAE",
+  CN: "China",
+  JP: "Japan",
+  KR: "South Korea",
+};
+
+export function originsPhrase(ls: readonly Pick<ResolvedOrderNowListing, "origin">[]): string {
+  return commaAnd(distinct(ls.map((l) => ORIGIN_SHORT[l.origin]).filter(Boolean)));
+}
+
+export function originPorts(ls: readonly Pick<ResolvedOrderNowListing, "origin">[]): string {
+  return commaAnd(distinct(ls.map((l) => ORIGIN_LABEL[l.origin]).filter(Boolean)));
+}
+
+export function buyLandingHead(car: Car, country: CountryMeta, listings: readonly ResolvedOrderNowListing[]) {
+  const p = profileOf(country.slug);
+  const name = `${car.brand} ${car.name}`;
+  const title = fitTitle(`Buy a ${name} in ${country.name}`, `${name} in ${country.name}`, `${car.name} in ${country.name}`);
+  const where = p.cities.length ? `delivered to ${commaAnd(p.cities.slice(0, 2)).replace(" and ", " or ")}` : `delivered in ${country.name}`;
+  const desc = fitDescription(
+    listings.length
+      ? `${name} for ${country.name}: ${plural(listings.length, "listing")} open to order, shipped into ${p.portShort} and ${where}.`
+      : `${name} for ${country.name}: sourced to order, shipped into ${p.portShort} and ${where}.`,
+    `Paperwork in ${p.language}, duty paid in ${country.currency} at clearance.`,
+  );
+  return { title, desc };
+}
+
+/** Opening paragraph: what is on offer for this destination. */
+export function buyIntro(car: Car, country: CountryMeta, listings: readonly ResolvedOrderNowListing[]): string {
+  const p = profileOf(country.slug);
+  const name = `${car.brand} ${car.name}`;
+  if (!listings.length) {
+    return `There is no ${name} listed for sale right now, so for ${country.name} we source one to your specification: you tell us the grade, drive side and budget, and the delivered figure into ${p.portShort} is agreed in writing before anything is bought.`;
+  }
+  const cond = conditionPhrase(listings);
+  return `${plural(listings.length, `${car.name} listing`)} can be ordered for delivery to ${country.name} today${cond ? `, ${cond}` : ""}, in ${gradeList(listings, 4)}. They ship from ${originsPhrase(listings)} and arrive through ${country.port}, where the car is cleared before it moves on to the address you give us.`;
+}
+
+/** Why the drive side of these particular listings suits (or does not suit) this country. */
+export function buyDriveNote(car: Car, country: CountryMeta, listings: readonly ResolvedOrderNowListing[]): string {
+  const lhd = listings.filter((l) => l.driveSide === "LHD").length;
+  const rhd = listings.length - lhd;
+  const base = `${country.name} drives on the right, so left-hand drive is the standard specification.`;
+  if (!listings.length) {
+    return car.drive === "RHD"
+      ? `${base} The ${car.name} is catalogued in right-hand drive only, so ask us to confirm ${country.name}'s registration rules for a right-hand-drive car before you order.`
+      : `${base} We source the ${car.name} in left-hand drive for ${country.name} unless you ask otherwise.`;
+  }
+  if (!rhd) return `${base} Every ${car.name} listed here is left-hand drive${listings.length > 1 ? `, all ${listings.length} of them` : ""}.`;
+  if (!lhd) return `${base} The ${car.name} listings here are right-hand drive, so ask us to confirm ${country.name}'s registration rules for a right-hand-drive car before you order.`;
+  return `${base} ${lhd} of the ${listings.length} ${car.name} listings are left-hand drive; the ${rhd === 1 ? "other is" : `other ${rhd} are`} right-hand drive, so check which one you are opening before you buy.`;
+}
+
+/**
+ * The route into this destination for this model: origin ports, the port of
+ * entry, the published sea transit, and the port-specific note from the
+ * destination profile.
+ */
+export function buyRouteParagraph(car: Car, country: CountryMeta, listings: readonly ResolvedOrderNowListing[]): string {
+  const p = profileOf(country.slug);
+  // Count listings per origin so the sentence says what this model actually
+  // ships from, e.g. "12 from UAE (Jebel Ali) and 4 from Japan (Yokohama)".
+  const byOrigin = new Map<string, number>();
+  for (const l of listings) byOrigin.set(l.origin, (byOrigin.get(l.origin) ?? 0) + 1);
+  const from = listings.length
+    ? byOrigin.size === 1
+      ? `${listings.length === 1 ? "The" : `All ${listings.length}`} ${car.name} ${listings.length === 1 ? "listing ships" : "listings ship"} from ${ORIGIN_LABEL[listings[0].origin as keyof typeof ORIGIN_LABEL]}.`
+      : `The ${car.name} listings ship from ${commaAnd([...byOrigin].map(([o, n]) => `${ORIGIN_LABEL[o as keyof typeof ORIGIN_LABEL]} (${n})`))}.`
+    : `A ${car.name} for ${country.name} is sourced in the UK, Europe or Asia.`;
+  const nonEurope = listings.some((l) => l.origin !== "UK" && l.origin !== "EU");
+  const transit = nonEurope
+    ? `The published ${country.transitDays} into ${p.portShort} is the crossing from the UK and Europe; from ${originsPhrase(listings.filter((l) => l.origin !== "UK" && l.origin !== "EU"))} the sailing is named in your quote.`
+    : `Sea transit into ${p.portShort} is typically ${country.transitDays} from the UK and Europe.`;
+  return `${from} ${p.note} ${transit}`;
+}
+
+/** Clearance and paperwork, specific to the destination's language and currency. */
+export function buyClearanceParagraph(car: Car, country: CountryMeta): string {
+  const p = profileOf(country.slug);
+  const paperwork =
+    p.language === "English"
+      ? `Entry paperwork in ${country.name} is in English, the same language as the export file raised for the ${car.name}.`
+      : `Entry paperwork in ${country.name} is in ${p.language}. The ${car.name}'s export file is raised in English and aligned with them before the vessel arrives.`;
+  return `${paperwork} Duty, levies and VAT are assessed by ${country.name} customs on the declared value, age and engine size, and are paid in ${country.currency}; the figure for your ${car.name} goes into the delivered quote.`;
+}
+
+/** Where the car goes after clearance, and which inland neighbours the same port serves. */
+export function buyDeliveryParagraph(car: Car, country: CountryMeta, p: CountryProfile = profileOf(country.slug)): {
+  text: string;
+  partners: CountryMeta[];
+} {
+  const partners = corridorPartners(p);
+  const cities = p.cities.length
+    ? `After clearance at ${p.portCity} the ${car.name} goes on by road to ${commaAnd(p.cities)} or any address in ${country.name}.`
+    : `After clearance the ${car.name} is delivered on to the address you give us in ${country.name}.`;
+  const corridor = partners.length
+    ? ` ${p.portCity} is also the way in for ${commaAnd(partners.map((o) => o.name))}; a ${car.name} bound further inland is quoted with the corridor included.`
+    : "";
+  return { text: `${cities}${corridor}`, partners };
+}
+
+/** One line of the model's own catalogue facts, for the page's model panel. */
+export function buySpecLine(car: Car): string {
+  const drive = car.drive === "Both" ? "LHD or RHD" : car.drive;
+  return [car.bodyStyle, car.powertrain, `${car.seats} seats`, car.power, drive].filter(Boolean).join(" · ");
+}
