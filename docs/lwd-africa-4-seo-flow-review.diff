+    cities: ["Praia", "Mindelo"],
+    note: "Cape Verde is an archipelago, so the destination is an island rather than a coastline: Praia on Santiago and Mindelo on São Vicente are the two ports, and which one you use depends on which island the car is going to.",
+  },
+  mauritania: {
+    geography: "coastal",
+    portShort: "Nouakchott",
+    portCity: "Nouakchott",
+    language: "Arabic and French",
+    cities: ["Nouakchott", "Nouadhibou"],
+    note: "Nouakchott is the commercial port and the capital, with Nouadhibou the second port to the north, and the country's short Atlantic frontage keeps the sea leg from Europe brief.",
+  },
+};
+
+const FALLBACK: CountryProfile = {
+  geography: "coastal",
+  portShort: "the destination port",
+  portCity: "the destination port",
+  language: "the local official language",
+  cities: [],
+  note: "",
+};
+
+export const profileOf = (slug: string): CountryProfile => PROFILES[slug] ?? FALLBACK;
+
+/** "a, b and c" — a list that reads as a sentence rather than a table. */
+export const commaAnd = (items: readonly string[]) =>
+  items.length < 2
+    ? items.join("")
+    : `${items.slice(0, -1).join(", ")} and ${items[items.length - 1]}`;
+
+/** Stable position of a country in the catalogue, used to rotate the shared blocks. */
+export const indexOfCountry = (slug: string) =>
+  Math.max(
+    0,
+    COUNTRIES.findIndex((c) => c.slug === slug),
+  );
+
+/**
+ * For a landlocked destination the `port` field reads "via Dakar / Abidjan
+ * (inland)". Stripped of its scaffolding it is the transit corridor, which is
+ * what the sentences actually want to name.
+ */
+export const corridorOf = (c: CountryMeta) =>
+  c.port.replace(/^via\s+/, "").replace(/\s*\(inland\)\s*$/, "");
+
+/** Slowest end of the published transit range, e.g. "24–30 days" -> 30. */
+export const transitMax = (c: CountryMeta) => {
+  const nums = c.transitDays.match(/\d+/g);
+  return nums ? Number(nums[nums.length - 1]) : 0;
+};
+
+/**
+ * Which landlocked destinations move through this country's port.
+ *
+ * Read straight out of the catalogue rather than asserted: Burkina Faso's entry
+ * already says "via Tema / Lomé", so Ghana's page can say that Tema is also
+ * Burkina Faso's way in, and link to it. No new claim, a genuinely different
+ * sentence on each coastal page, and a real link between two pages that a
+ * visitor might actually want to follow.
+ */
+export const corridorPartners = (p: CountryProfile) =>
+  p.geography === "coastal"
+    ? COUNTRIES.filter(
+        (o) => profileOf(o.slug).geography === "landlocked" && o.port.includes(p.portCity),
+      )
+    : [];
diff --git a/src/lib/seo-content/hub-copy.ts b/src/lib/seo-content/hub-copy.ts
new file mode 100644
index 0000000..fef645a
--- /dev/null
+++ b/src/lib/seo-content/hub-copy.ts
@@ -0,0 +1,146 @@
+/**
+ * Copy for the listing hubs: /make/<make> and /body-type/<type>.
+ *
+ * Search intent:
+ *  - /make/<make>: "<make> cars for sale" with prices, the inventory for one
+ *    marque. The brand guide (/brands/<brand>, four marques) owns the advisory
+ *    "sourcing a <make> for West Africa" query and links here for the listings.
+ *  - /body-type/<type>: "<pickups | SUVs | vans> for sale" across makes.
+ *
+ * Every figure is a count or a list taken from the listings the page renders.
+ * Nothing claims a vehicle is physically held, photographed as the exact unit,
+ * or delivered within a time the listing does not state.
+ */
+import { CARS } from "@/lib/data";
+import {
+  BODY_TYPE_LABEL,
+  bodyTypeOf,
+  makeOf,
+  type BodyType,
+  type ResolvedOrderNowListing,
+} from "@/lib/order-now";
+import { commaAnd, fitDescription, fitTitle, plural } from "./text";
+import { conditionPhrase, driveSidePhrase, yearSpan } from "./listings";
+import { originsPhrase } from "./buy-landing-copy";
+
+export interface ModelCount {
+  slug: string;
+  name: string;
+  count: number;
+}
+
+/** Models in a set of listings, most listed first, with their catalogue name. */
+export function modelsOf(ls: readonly ResolvedOrderNowListing[]): ModelCount[] {
+  const m = new Map<string, number>();
+  for (const l of ls) m.set(l.carSlug, (m.get(l.carSlug) ?? 0) + 1);
+  return [...m]
+    .map(([slug, count]) => {
+      const car = CARS.find((c) => c.slug === slug);
+      return { slug, name: car ? `${car.brand} ${car.name}` : slug, count };
+    })
+    .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
+}
+
+/** Makes in a set of listings, most listed first. */
+export function makesOf(ls: readonly ResolvedOrderNowListing[]): { make: string; count: number }[] {
+  const m = new Map<string, number>();
+  for (const l of ls) m.set(makeOf(l), (m.get(makeOf(l)) ?? 0) + 1);
+  return [...m].map(([make, count]) => ({ make, count })).sort((a, b) => b.count - a.count || a.make.localeCompare(b.make));
+}
+
+/** Body types in a set of listings, most listed first. */
+export function bodiesOf(ls: readonly ResolvedOrderNowListing[]): { type: BodyType; label: string; count: number }[] {
+  const m = new Map<BodyType, number>();
+  for (const l of ls) m.set(bodyTypeOf(l), (m.get(bodyTypeOf(l)) ?? 0) + 1);
+  return [...m].map(([type, count]) => ({ type, label: BODY_TYPE_LABEL[type], count })).sort((a, b) => b.count - a.count);
+}
+
+/** Model names without the make repeated ("Land Cruiser 300", not "Toyota Land Cruiser 300"). */
+const shortModel = (make: string, name: string) => (name.startsWith(`${make} `) ? name.slice(make.length + 1) : name);
+
+export function makeHead(make: string, ls: readonly ResolvedOrderNowListing[]) {
+  const models = modelsOf(ls).map((m) => shortModel(make, m.name));
+  const title = fitTitle(`${make} cars for sale, delivered to West Africa`, `${make} cars for sale, West Africa`, `${make} cars for sale`);
+  const desc = fitDescription(
+    `${plural(ls.length, `${make} listing`)} with a vehicle price${models.length > 1 ? `, across ${listUpTo(models, 4)}` : `: the ${models[0]}`}.`,
+    `${cap(conditionPhrase(ls) || "listed")}, ${driveSidePhrase(ls)}, shipped from ${originsPhrase(ls)} to West Africa.`,
+  );
+  return { title, desc };
+}
+
+/** "a, b and c", or "a, b, c, d and more" when the list is longer than `n`. */
+const listUpTo = (xs: readonly string[], n: number) =>
+  xs.length > n ? `${xs.slice(0, n).join(", ")} and more` : commaAnd(xs);
+
+const cap = (s: string) => (s ? `${s[0].toUpperCase()}${s.slice(1)}` : s);
+
+/** Opening paragraph for a make hub, entirely from the listings it shows. */
+export function makeIntro(make: string, ls: readonly ResolvedOrderNowListing[]): string {
+  const models = modelsOf(ls);
+  const years = yearSpan(ls);
+  const cond = conditionPhrase(ls);
+  const lead =
+    models.length === 1
+      ? `${plural(ls.length, `${models[0].name} listing`)} with a vehicle price`
+      : `${plural(ls.length, `${make} listing`)} with a vehicle price, across ${plural(models.length, "model")}`;
+  return `${lead}${years ? `, model years ${years}` : ""}${cond ? `, ${cond}` : ""}, in ${driveSidePhrase(ls)}. They ship from ${originsPhrase(ls)}; open any listing for its specification, and shipping to your West African port is added at checkout.`;
+}
+
+/** Truthful intro for a body-type hub. Replaces copy that called every listing "a real vehicle with its own photos". */
+export function bodyIntro(label: string, ls: readonly ResolvedOrderNowListing[]): string {
+  if (!ls.length) return `No ${label.toLowerCase()} listings are open right now. Tell us what you need and we source one to order.`;
+  const makes = makesOf(ls);
+  const years = yearSpan(ls);
+  return `${plural(ls.length, "listing")} with a vehicle price from ${plural(makes.length, "make")}, led by ${commaAnd(makes.slice(0, 3).map((m) => m.make))}${years ? `, model years ${years}` : ""}, in ${driveSidePhrase(ls)}. They ship from ${originsPhrase(ls)}, and shipping to your West African port is added at checkout.`;
+}
+
+export function bodyHead(h1: string, label: string, ls: readonly ResolvedOrderNowListing[]) {
+  const makes = makesOf(ls).map((m) => m.make);
+  // The hub's own h1 ("Pickups for sale, export to West Africa") is the first
+  // choice; the shorter "<label> for sale in West Africa" when it overruns.
+  const title = fitTitle(h1, `${h1.split(",")[0]}, West Africa`, `${label} for sale`);
+  const desc = ls.length
+    ? fitDescription(
+        `${plural(ls.length, `${label.toLowerCase()} listing`)} with prices from ${listUpTo(makes, 4)}.`,
+        `${cap(conditionPhrase(ls) || "listed")}, ${driveSidePhrase(ls)}, shipped from ${originsPhrase(ls)} to West Africa.`,
+      )
+    : fitDescription(`${label} for West Africa, sourced to order and shipped door to door.`);
+  return { title, desc };
+}
+
+/** Models shown on a make hub that also have a model guide. */
+export function modelGuides(ls: readonly ResolvedOrderNowListing[]) {
+  return modelsOf(ls).filter((m) => CARS.some((c) => c.slug === m.slug));
+}
+
+
+/**
+ * The makes most like this one by what they sell (share of SUVs, pickups,
+ * vans...), for a short "comparable makes" list. The full list of makes lives
+ * on /buy-now; printing all forty on every make hub would be forty copies of
+ * one block.
+ */
+export function comparableMakes(
+  make: string,
+  all: readonly ResolvedOrderNowListing[],
+  n = 8,
+): { make: string; count: number }[] {
+  const mix = (m: string) => {
+    const ls = all.filter((l) => makeOf(l) === m);
+    const out = new Map<BodyType, number>();
+    for (const l of ls) out.set(bodyTypeOf(l), (out.get(bodyTypeOf(l)) ?? 0) + 1 / ls.length);
+    return out;
+  };
+  const mine = mix(make);
+  return makesOf(all)
+    .filter((m) => m.make !== make)
+    .map((m) => {
+      const theirs = mix(m.make);
+      let overlap = 0;
+      for (const [t, v] of mine) overlap += Math.min(v, theirs.get(t) ?? 0);
+      return { ...m, overlap };
+    })
+    .sort((a, b) => b.overlap - a.overlap || b.count - a.count || a.make.localeCompare(b.make))
+    .slice(0, n)
+    .map(({ make: m, count }) => ({ make: m, count }));
+}
diff --git a/src/lib/seo-content/listings.ts b/src/lib/seo-content/listings.ts
new file mode 100644
index 0000000..88b15f9
--- /dev/null
+++ b/src/lib/seo-content/listings.ts
@@ -0,0 +1,154 @@
+/**
+ * Listing identity for search: the name a listing is shown and titled under,
+ * and which URL is the canonical one when the catalogue holds the same car
+ * twice.
+ *
+ * Pure functions over the static catalogue. Nothing here reads or changes a
+ * price, a stock position or a lead time.
+ */
+import type { Car } from "@/lib/data";
+import {
+  ORDER_NOW_LISTINGS,
+  bodyTypeOf,
+  listingName,
+  type BodyType,
+  type OrderNowListing,
+} from "@/lib/order-now";
+import { commaAnd } from "./text";
+
+// Whitespace only: "G-Class" must not swallow the "G" of the grade "G 500".
+const tokens = (s: string) => s.toLowerCase().split(/\s+/).filter(Boolean);
+
+/**
+ * Year, model and grade without the model repeated inside the grade.
+ *
+ * Several supplier grades restate the model ("GLE" + "GLE 450 4MATIC",
+ * "Ranger Raptor" + "Raptor Double Cab", "Mercedes-AMG G 63" + "AMG"), which
+ * reads as a typo in a title and a heading. Leading grade words that already
+ * appear in the model name are dropped; nothing else changes.
+ */
+export function cleanListingName(l: Pick<OrderNowListing, "year" | "title" | "grade">): string {
+  const titleWords = new Set(tokens(l.title));
+  const grade = (l.grade || "").split(/\s+/).filter(Boolean);
+  while (grade.length && titleWords.has(grade[0].toLowerCase())) grade.shift();
+  return [l.year, l.title, grade.join(" ")].filter(Boolean).join(" ");
+}
+
+const visible = ORDER_NOW_LISTINGS.filter((l) => !l.unlisted);
+
+/** Listings grouped by their full catalogue name. */
+const byName = new Map<string, OrderNowListing[]>();
+for (const l of visible) {
+  const k = listingName(l).toLowerCase();
+  const g = byName.get(k);
+  if (g) g.push(l);
+  else byName.set(k, [l]);
+}
+
+/**
+ * How specific a catalogue entry is. A numbered supplier unit (stock ref) beats
+ * an owner-described unit (condition set), which beats a generic
+ * configuration line.
+ */
+const specificity = (l: OrderNowListing) => (l.stockRef ? 2 : 0) + (l.condition ? 1 : 0);
+
+/**
+ * Where two catalogue entries describe the same car under the same name, the
+ * less specific one points its canonical at the more specific one. Two equally
+ * specific entries (two numbered units, e.g. two Cybertrucks) are genuinely
+ * separate vehicles: neither is canonicalised, both are disambiguated by stock
+ * reference instead.
+ */
+const CANONICAL = new Map<string, string>();
+const AMBIGUOUS = new Set<string>();
+for (const group of byName.values()) {
+  if (group.length < 2) continue;
+  const best = Math.max(...group.map(specificity));
+  const top = group.filter((l) => specificity(l) === best);
+  if (top.length === 1) {
+    for (const l of group) if (l !== top[0]) CANONICAL.set(l.slug, top[0].slug);
+  } else {
+    for (const l of top) if (l.stockRef) AMBIGUOUS.add(l.slug);
+  }
+}
+
+/** The slug whose URL is canonical for this listing (itself unless it duplicates another). */
+export function canonicalListingSlug(slug: string): string {
+  return CANONICAL.get(slug) ?? slug;
+}
+
+/** False for the duplicate half of a same-car pair: keep it out of the sitemap. */
+export function isCanonicalListing(slug: string): boolean {
+  return !CANONICAL.has(slug);
+}
+
+/** The duplicate pairs, for reporting and for the sitemap owner. */
+export const DUPLICATE_LISTINGS: ReadonlyArray<readonly [duplicate: string, canonical: string]> = [
+  ...CANONICAL,
+];
+
+/**
+ * The name used in a listing page's title and h1. Two separate units that share
+ * a name get their stock reference, so two pages never carry the same heading.
+ */
+export function listingDisplayName(l: OrderNowListing): string {
+  const name = cleanListingName(l);
+  return AMBIGUOUS.has(l.slug) && l.stockRef ? `${name} (${l.stockRef})` : name;
+}
+
+/**
+ * The browse-by-body-type hub a model belongs to. Taken from its own listings
+ * where it has any (the hub pages are built from the same function), otherwise
+ * read from the catalogue's body style.
+ */
+export function bodyHubForCar(car: Car): BodyType {
+  const counts = new Map<BodyType, number>();
+  for (const l of visible) if (l.carSlug === car.slug) counts.set(bodyTypeOf(l), (counts.get(bodyTypeOf(l)) ?? 0) + 1);
+  if (counts.size) return [...counts].sort((a, b) => b[1] - a[1])[0][0];
+  const s = car.bodyStyle.toLowerCase();
+  if (/pickup/.test(s)) return "pickup";
+  if (/minibus|\bbus\b/.test(s)) return "bus";
+  if (/van|mpv/.test(s)) return "van";
+  if (/truck/.test(s)) return "truck";
+  if (/sedan|saloon|hatch|convertible|grand tourer|supercar|city car|shooting brake/.test(s)) return "saloon";
+  return "suv";
+}
+
+/** Distinct values, in first-seen order. */
+export function distinct<T>(xs: readonly T[]): T[] {
+  return [...new Set(xs)];
+}
+
+/** "2024 to 2026", "2026", or "" when no listing states a year. */
+export function yearSpan(ls: readonly Pick<OrderNowListing, "year">[]): string {
+  const ys = ls.map((l) => l.year).filter((y): y is number => typeof y === "number");
+  if (!ys.length) return "";
+  const lo = Math.min(...ys);
+  const hi = Math.max(...ys);
+  return lo === hi ? String(lo) : `${lo} to ${hi}`;
+}
+
+/** "new and used", "new", "used", or "" from the listings' stated condition. */
+export function conditionPhrase(ls: readonly Pick<OrderNowListing, "condition">[]): string {
+  const c = distinct(ls.map((l) => l.condition).filter(Boolean) as string[]);
+  return c.length === 2 ? "new and used" : (c[0] ?? "");
+}
+
+/** "left-hand drive", "right-hand drive" or "left- and right-hand drive". */
+export function driveSidePhrase(ls: readonly Pick<OrderNowListing, "driveSide">[]): string {
+  const d = distinct(ls.map((l) => l.driveSide));
+  if (d.length === 2) return "left- and right-hand drive";
+  return d[0] === "RHD" ? "right-hand drive" : "left-hand drive";
+}
+
+/** Grades listed, cleaned, as a readable list capped at `max`. */
+export function gradeList(ls: readonly OrderNowListing[], max = 5): string {
+  const gs = distinct(
+    ls.map((l) => {
+      const n = cleanListingName({ title: l.title, grade: l.grade });
+      return n.slice(l.title.length).trim();
+    }).filter(Boolean),
+  );
+  const shown = gs.slice(0, max);
+  return gs.length > max ? `${shown.join(", ")} and ${gs.length - max} more` : commaAnd(shown);
+}
diff --git a/src/lib/seo-content/text.ts b/src/lib/seo-content/text.ts
new file mode 100644
index 0000000..e0b22a3
--- /dev/null
+++ b/src/lib/seo-content/text.ts
@@ -0,0 +1,65 @@
+/**
+ * Small, pure text helpers for page titles and descriptions on the
+ * programmatic templates (/cars, /buy-now, /buy, /make, /body-type, /brands,
+ * /ship-to).
+ *
+ * The limits are the lengths a search result actually shows: about 60
+ * characters of title and about 158 of description. Anything beyond is cut by
+ * the engine at an arbitrary point, so we choose the cut instead.
+ */
+
+export const TITLE_MAX = 60;
+export const DESC_MAX = 158;
+export const BRAND_SUFFIX = " | LWD Africa";
+
+/**
+ * The first candidate that fits, with " | LWD Africa" appended. Candidates are
+ * ordered most specific first. If none fits, the last candidate is cut at a
+ * word boundary so the title never runs past the limit.
+ */
+export function fitTitle(...candidates: string[]): string {
+  for (const c of candidates) {
+    const t = `${c}${BRAND_SUFFIX}`;
+    if (t.length <= TITLE_MAX) return t;
+  }
+  const last = candidates[candidates.length - 1] ?? "";
+  if (last.length <= TITLE_MAX) return last;
+  return cutAtWord(last, TITLE_MAX);
+}
+
+/** Cut to `max` characters at a word boundary, without a trailing comma or colon. */
+export function cutAtWord(s: string, max: number): string {
+  const clean = s.replace(/\s+/g, " ").trim();
+  if (clean.length <= max) return clean;
+  const cut = clean.slice(0, max + 1);
+  const at = cut.lastIndexOf(" ");
+  return (at > max * 0.6 ? cut.slice(0, at) : clean.slice(0, max)).replace(/[\s,;:(-]+$/, "");
+}
+
+/**
+ * A description built from sentences, keeping as many whole sentences as fit
+ * inside 158 characters. Only if the first sentence alone is too long is it cut
+ * at a word boundary and closed with a full stop.
+ */
+export function fitDescription(...sentences: string[]): string {
+  const parts = sentences.map((s) => s.replace(/\s+/g, " ").trim()).filter(Boolean);
+  let out = "";
+  for (const p of parts) {
+    const next = out ? `${out} ${p}` : p;
+    if (next.length <= DESC_MAX) out = next;
+    else if (!out) return `${cutAtWord(p, DESC_MAX - 1).replace(/\.$/, "")}.`;
+    else break;
+  }
+  return out;
+}
+
+/** "a, b and c": a list that reads as a sentence rather than a table. */
+export function commaAnd(items: readonly string[]): string {
+  const xs = items.filter(Boolean);
+  return xs.length < 2 ? xs.join("") : `${xs.slice(0, -1).join(", ")} and ${xs[xs.length - 1]}`;
+}
+
+/** "1 listing" / "3 listings". */
+export function plural(n: number, one: string, many = `${one}s`): string {
+  return `${n} ${n === 1 ? one : many}`;
+}
