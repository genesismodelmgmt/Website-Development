@@ -0,0 +1,57 @@
+/**
+ * Site-wide SEO constants shared by the root head, the sitemaps and any route
+ * that emits structured data. One place for the origin and the entity ids, so
+ * every page's JSON-LD points at the same Organization node instead of
+ * declaring a fresh, unlinked one.
+ */
+
+/** Canonical origin. No trailing slash. */
+export const SITE_URL = "https://lwdcarsafrica.com";
+
+/** The one Organization entity, declared in full by the root route on every page. */
+export const ORG_ID = `${SITE_URL}/#organization`;
+
+/** The WebSite entity, declared on the home page. */
+export const WEBSITE_ID = `${SITE_URL}/#website`;
+
+/**
+ * Share image used when a route does not set its own og:image. It is the image
+ * the home page already uses for its social card, so no page ever shares
+ * without a preview.
+ */
+export const DEFAULT_OG_IMAGE =
+  "https://storage.googleapis.com/gpt-engineer-file-uploads/A4kmr2gMZSeny4vrN8kxaiJzVvY2/social-images/social-1784449781304-IMG_1085.webp";
+
+/** Absolute URL for a site path ("/cars" -> "https://lwdcarsafrica.com/cars"). */
+export function absoluteUrl(path: string): string {
+  if (/^https?:\/\//.test(path)) return path;
+  return `${SITE_URL}${path.startsWith("/") ? path : `/${path}`}`;
+}
+
+/**
+ * Reference to the site Organization for use inside other JSON-LD nodes, e.g.
+ * `seller: orgRef()` on an Offer. A bare `{ "@type": "Organization", name }`
+ * creates a second, anonymous organisation in Google's graph.
+ */
+export function orgRef(): { "@id": string } {
+  return { "@id": ORG_ID };
+}
+
+/**
+ * Robots meta for transactional and private pages (checkout, order, quote,
+ * payment, admin). "follow" lets link equity pass back to public pages;
+ * pass `false` for pages whose links should not be followed either.
+ */
+export function noindexMeta(follow = true): { name: "robots"; content: string } {
+  return { name: "robots", content: follow ? "noindex,follow" : "noindex,nofollow" };
+}
+
+/** XML-escape a value for a sitemap <loc>. */
+export function xmlEscape(s: string): string {
+  return s
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&apos;");
+}
diff --git a/src/routes/__root.tsx b/src/routes/__root.tsx
index 8e013fe..17f57f3 100644
--- a/src/routes/__root.tsx
+++ b/src/routes/__root.tsx
@@ -16,6 +16,13 @@ import { DisplayCurrencyProvider } from "@/components/display-currency-provider"
 import { OFFICE } from "@/lib/contact";
 import { fetchWeeklyRate } from "@/lib/weekly-rate.functions";
 import { setUsdRate } from "@/lib/charge";
+import { DEFAULT_OG_IMAGE, ORG_ID, SITE_URL } from "@/lib/seo/site";
+
+// 50 characters.
+const DEFAULT_TITLE = "LWD Africa | Car export and freight to West Africa";
