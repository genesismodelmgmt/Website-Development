+import { createFileRoute, Link, notFound } from "@tanstack/react-router";
+import { useState } from "react";
+import { SiteNav, SiteFooter } from "@/components/site-nav";
+import { WhatsAppFab } from "@/components/whatsapp-fab";
+import { FreightQuoteDialog } from "@/components/freight-quote-dialog";
+import { ServicePhoto } from "@/components/service-photo";
+import { SERVICES, getService, type Service } from "@/lib/services";
+import { EMAIL, EMAIL_HREF, TEL_HREF, WA_DISPLAY, waLink, waTrackedProps, telTrackedProps, emailTrackedProps } from "@/lib/contact";
+import { track } from "@/lib/analytics";
+
+const BASE = "https://lwdcarsafrica.com";
+const SOCIAL_IMAGE =
+  "https://storage.googleapis.com/gpt-engineer-file-uploads/A4kmr2gMZSeny4vrN8kxaiJzVvY2/social-images/social-1784449781304-IMG_1085.webp";
+
+/**
+ * Lowercase a list item so it reads as prose mid-sentence, but leave acronyms
+ * and figures alone: "Make, model and year" becomes "make, model and year",
+ * while "RO-RO or container…" and "20ft, 40ft and…" are untouched.
+ */
+const lowerFirst = (t: string) => (/^[A-Z][a-z]/.test(t) ? t.charAt(0).toLowerCase() + t.slice(1) : t);
+
+const sentences = (t: string) => t.match(/[^.]+\./g)?.map((x) => x.trim()) ?? [t];
+
+/** "a, b, c" -> "a, b and c", so a list reads as a sentence rather than a table. */
+const commaAnd = (items: string[]) =>
+  items.length < 2 ? items.join("") : `${items.slice(0, -1).join(", ")} and ${items[items.length - 1]}`;
+
+/**
+ * The per-service question set.
+ *
+ * Every word of every answer comes from that service's own entry in
+ * `src/lib/services.ts` — the `needed`, `intro`, `includes`, `summary` and
+ * `typical` fields — recombined into prose, with only neutral connective
+ * wording added. Nothing here asserts anything the catalogue does not.
+ *
+ * It exists because ten service pages built from the same template read as
+ * near-duplicates to a search engine; this is the same answer the rest of the
+ * site already uses on /cars/$slug and /ship-to/$country. The visible block and
+ * the FAQPage structured data are generated from this one function so they can
+ * never drift apart.
+ */
+function serviceFaq(s: Service): { q: string; a: string }[] {
+  // Only the opening sentence of the intro is reused, so the page does not
+  // print the same paragraph twice; `summary` is copy that appears nowhere else
+  // on this page.
+  const openingSentence = sentences(s.intro)[0];
+  return [
+    {
+      q: `What do you need to quote ${s.name}?`,
+      a: `To quote it we need ${s.needed.map(lowerFirst).join("; ")}. Send what you have and we will tell you what else the movement needs.`,
+    },
+    {
+      q: `What does ${s.name} cover?`,
+      a: `${openingSentence} It covers ${s.includes.map(lowerFirst).join("; ")}.`,
+    },
+    {
+      q: `Is ${s.name} the right service for my cargo?`,
+      a: `${s.summary} Typically that means ${commaAnd(s.typical.map(lowerFirst))}.`,
+    },
+  ];
+}
+
+export const Route = createFileRoute("/shipping/$service")({
+  loader: ({ params }) => {
+    const service = getService(params.service);
+    if (!service) throw notFound();
+    return { service };
+  },
+  head: ({ loaderData }) => {
+    if (!loaderData) {
+      return {
+        meta: [
+          { title: "Service not found | LWD Africa" },
+          { name: "robots", content: "noindex" },
+        ],
+      };
+    }
+    const { service: s } = loaderData;
+    const url = `${BASE}/shipping/${s.slug}`;
+    const title = `${s.name} — Export Freight & Logistics | LWD Africa`;
+    const desc = `${s.summary} LWD Africa quotes any lane — tell us the cargo, where it is now and where it needs to go. WhatsApp +44 7568 765929.`;
+    const keywords = [
+      s.name,
+      `${s.name} quote`,
+      ...s.typical.map((t) => `${t} shipping`),
+      "export logistics",
+      "freight forwarding",
+      "LWD Africa",
+    ].join(", ");
+
+    return {
+      meta: [
+        { title },
+        { name: "description", content: desc },
+        { name: "keywords", content: keywords },
+        { property: "og:title", content: title },
+        { property: "og:description", content: desc },
+        { property: "og:type", content: "website" },
+        { property: "og:url", content: url },
+        { property: "og:site_name", content: "LWD Africa" },
+        { property: "og:locale", content: "en_GB" },
+        { property: "og:image", content: SOCIAL_IMAGE },
+        { property: "og:image:secure_url", content: SOCIAL_IMAGE },
+        { property: "og:image:width", content: "1200" },
+        { property: "og:image:height", content: "630" },
+        { property: "og:image:alt", content: "LWD Africa — export freight and logistics" },
+        { name: "twitter:card", content: "summary_large_image" },
+        { name: "twitter:title", content: title },
+        { name: "twitter:description", content: desc },
+        { name: "twitter:image", content: SOCIAL_IMAGE },
+        { name: "twitter:image:alt", content: "LWD Africa — export freight and logistics" },
+        { name: "robots", content: "index,follow,max-image-preview:large,max-snippet:-1" },
+      ],
+      links: [{ rel: "canonical", href: url }],
+      scripts: [
+        {
+          type: "application/ld+json",
+          children: JSON.stringify({
+            "@context": "https://schema.org",
+            "@type": "Service",
+            "@id": `${url}#service`,
+            name: s.name,
+            serviceType: s.name,
+            description: `${s.summary} ${s.intro}`,
+            url,
+            // The site-wide Organization node in __root.tsx carries this @id and
+            // ships on every page, so the reference resolves in the same
+            // document it appears in.
+            provider: { "@id": `${BASE}/#organization` },
+            areaServed: { "@type": "Place", name: "Worldwide" },
+          }),
+        },
+        {
+          type: "application/ld+json",
+          children: JSON.stringify({
+            "@context": "https://schema.org",
+            "@type": "FAQPage",
+            "@id": `${url}#faq`,
+            mainEntity: serviceFaq(s).map((f) => ({
+              "@type": "Question",
+              name: f.q,
+              acceptedAnswer: { "@type": "Answer", text: f.a },
+            })),
+          }),
+        },
+        {
+          type: "application/ld+json",
+          children: JSON.stringify({
+            "@context": "https://schema.org",
+            "@type": "BreadcrumbList",
+            itemListElement: [
+              { "@type": "ListItem", position: 1, name: "Home", item: `${BASE}/` },
+              { "@type": "ListItem", position: 2, name: "Freight & logistics", item: `${BASE}/shipping` },
+              { "@type": "ListItem", position: 3, name: s.name, item: url },
+            ],
+          }),
+        },
+      ],
+    };
+  },
+  component: ServicePage,
+  notFoundComponent: () => (
+    <div className="min-h-screen flex items-center justify-center bg-background text-foreground">
