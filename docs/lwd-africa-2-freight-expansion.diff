+                    className="hover:text-primary transition-colors"
+                  >{WA_DISPLAY}</a>
+                </dd>
+              </div>
+              <div>
+                <dt className="text-primary uppercase text-xs tracking-wider">Phone</dt>
+                <dd className="mt-1">
+                  <a href={TEL_HREF} {...telTrackedProps("shipping_hub")} className="hover:text-primary transition-colors">{WA_DISPLAY}</a>
+                </dd>
+              </div>
+              <div className="sm:col-span-2">
+                <dt className="text-primary uppercase text-xs tracking-wider">Email</dt>
+                <dd className="mt-1">
+                  <a href={EMAIL_HREF} {...emailTrackedProps("shipping_hub")} className="hover:text-primary transition-colors">{EMAIL}</a>
+                </dd>
+              </div>
+            </dl>
+          </div>
+
+          <aside className="relative dealer-panel p-8 md:p-10 rounded-2xl overflow-hidden">
+            <div
+              className="absolute inset-0 opacity-[0.07] pointer-events-none"
+              style={{ background: "radial-gradient(70% 90% at 100% 0%, var(--gold), transparent)" }}
+            />
+            <div className="relative">
+              <div className="eyebrow">Freight quote</div>
+              <div className="mt-4 font-display text-4xl md:text-5xl font-semibold leading-[1.05]">
+                Five questions.
+              </div>
+              <p className="mt-4 text-sm text-muted-foreground leading-relaxed max-w-sm">
+                What the cargo is, where it is now, where it is going, a line of description and roughly when it is ready. That is enough for us to come back to you.
+              </p>
+              <div className="mt-8 grid gap-3">
+                <button
+                  type="button"
+                  onClick={() => openQuote("shipping_closing_quote")}
+                  className="btn-gold w-full !py-4"
+                >
+                  Start a freight quote
+                </button>
+                <a href={TEL_HREF} {...telTrackedProps("shipping_hub")} className="btn-outline w-full !py-4">Call {WA_DISPLAY}</a>
+              </div>
+            </div>
+          </aside>
+        </div>
+      </section>
+
+      <SiteFooter />
+      <WhatsAppFab />
+      <FreightQuoteDialog
+        open={quoteOpen}
+        onClose={() => setQuoteOpen(false)}
+        initialOrigin={lane.origin}
+        initialDestination={lane.destination}
+        source="shipping_hub"
+      />
+    </div>
+  );
+}
