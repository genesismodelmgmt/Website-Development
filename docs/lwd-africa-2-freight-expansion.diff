+// The freight and logistics catalogue.
+//
+// This is the single source of truth for what LWD Africa says it does beyond
+// sourcing cars. Copy lives here rather than in the routes so the hub page, the
+// service pages, the quote flow and the structured data cannot drift apart.
+//
+// Discipline for anyone editing this file: state capability, never invent
+// specifics. No prices, no guaranteed transit times, no named carriers, agents,
+// certifications or facilities unless the owner has confirmed them in writing.
+// The site's credibility is the asset being protected here.
+
+export interface Service {
+  slug: string;
+  /** Short name, used in the nav, cards and breadcrumbs. */
+  name: string;
+  /** Uppercase kicker above the heading, in the site's existing style. */
+  kicker: string;
+  /** One sentence. Used on cards and as the meta description seed. */
+  summary: string;
+  /** Two or three sentences for the top of the service page. */
+  intro: string;
+  /** What the service covers. Shown as a checked list. */
+  includes: string[];
+  /** What we need from the customer before we can quote. Drives the quote flow. */
+  needed: string[];
+  /** Typical cargo, for the "is this me?" test. */
+  typical: string[];
+  /** Plain description of the photograph this page wants. */
+  photo: string;
+  /**
+   * Photography, added once it has been sourced and licensed. Until then the
+   * photo slot renders a deliberate panel rather than an empty box, so a
+   * missing image never looks like a fault. Dropping a picture in is one line.
+   */
+  image?: string;
+  /** Alt text describing the actual photograph. Falls back to the service name. */
+  imageAlt?: string;
+  /** Credit line, rendered under the picture and mirrored on /image-credits. */
+  imageCredit?: string;
+}
+
+export const SERVICES: Service[] = [
+  {
+    slug: "vehicle-shipping",
+    name: "Vehicle shipping, A to B",
