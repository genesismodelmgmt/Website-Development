--- /dev/null
+++ b/src/components/service-photo.tsx
@@ -0,0 +1,100 @@
+import { BrandWordmark } from "@/components/brand-mark";
+import type { Service } from "@/lib/services";
+
+/**
+ * The photo slot for a freight service page.
+ *
+ * The catalogue in `src/lib/services.ts` currently describes the photograph each
+ * service wants (`Service.photo`) but carries no picture. Rather than ship a
+ * stock-photo grey box or an "image coming soon" apology, the slot renders a
+ * deliberate panel in the site's own language until a real photograph exists.
+ *
+ * Dropping a photograph in later is a one-line change per service: add
+ * `image: "https://…"` (or a path under `public/`) to that service's entry and
+ * this component switches to a proper responsive <img>. Two further optional
+ * fields are read if present:
+ *
+ *   image?: string        the photograph itself
+ *   imageAlt?: string     alt text describing the actual photograph
+ *   imageCredit?: string  a credit line, rendered under the picture
+ *
+ * They are read through the local type below so that `Service` does not have to
+ * carry them before the photography exists. When they are added to the `Service`
+ * interface this alias becomes redundant and can be deleted; nothing else here
+ * changes.
+ */
+type PhotographedService = Service & {
+  image?: string;
+  imageAlt?: string;
+  imageCredit?: string;
+};
+
+interface Props {
+  service: Service;
+  /** Extra classes for the outer panel, e.g. layout or ordering. */
+  className?: string;
+  /** Passed straight to the <img>. Defaults to the service page's column width. */
+  sizes?: string;
+}
+
+export function ServicePhoto({
+  service,
+  className = "",
+  sizes = "(min-width: 1024px) 640px, 92vw",
+}: Props) {
+  const { image, imageAlt, imageCredit } = service as PhotographedService;
+
+  if (image) {
+    return (
+      <figure className={`dealer-panel overflow-hidden ${className}`}>
+        {/* 16/10 matches the vehicle cards elsewhere on the site. The width and
+            height attributes declare that ratio so the page does not reflow
+            while the file loads; object-cover absorbs any real-world ratio. */}
+        <div className="aspect-[16/10] bg-[color:var(--surface)] img-zoom">
+          <img
+            src={image}
+            sizes={sizes}
+            alt={imageAlt ?? service.name}
+            width={1280}
+            height={800}
+            loading="lazy"
+            decoding="async"
+            className="w-full h-full object-cover"
+          />
+        </div>
+        {imageCredit ? (
+          <figcaption className="border-t border-border px-4 py-3 text-[11px] leading-relaxed text-muted-foreground">
+            {imageCredit}
+          </figcaption>
+        ) : null}
+      </figure>
+    );
+  }
+
+  return (
+    // A quiet brand plate, not a caption. The panel sits directly beside the
+    // page heading on large screens and directly above it on a phone, so it must
+    // not carry the kicker or the service name: printing either would show the
+    // reader the same two lines twice, stacked, which reads as a fault rather
+    // than as a design. Decorative for assistive technology; `data-photo-brief`
+    // carries the art direction from the catalogue for whoever sources the
+    // photograph, and is invisible to visitors.
+    <div
+      aria-hidden="true"
+      data-photo-brief={service.photo}
+      className={`dealer-panel relative overflow-hidden ${className}`}
+    >
+      <div
+        className="absolute inset-0 opacity-[0.07] pointer-events-none"
+        style={{ background: "radial-gradient(70% 90% at 100% 0%, var(--gold), transparent)" }}
+      />
+      {/* w-full keeps the width definite. With width:auto the aspect ratio is
+          resolved from min-height instead (190 × 1.6 = 304px), which overflows
+          the panel below about 350px. */}
+      <div className="relative w-full aspect-[16/10] min-h-[190px] p-6 sm:p-8 flex flex-col items-center justify-center gap-5">
+        <BrandWordmark className="text-2xl sm:text-3xl opacity-25" />
+        <div className="luxury-rule w-16" />
+      </div>
+    </div>
+  );
+}
