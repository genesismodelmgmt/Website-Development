+    includes: [
+      "Collection from a home, dealer, auction house or compound",
+      "Export documentation and the bill of lading",
+      "RO-RO or container, whichever suits the vehicle and the route",
+      "Optional cargo insurance for the vehicle's declared value",
+      "Customs clearance at origin and destination",
+      "Inland delivery to the final address",
+    ],
+    needed: [
