@@ -0,0 +1,305 @@
+import { useEffect, useMemo, useRef, useState, type ReactNode } from "react";
+import * as DialogPrimitive from "@radix-ui/react-dialog";
+import { CARGO_TYPES, DESTINATION_REGIONS, ORIGIN_REGIONS, type Service } from "@/lib/services";
+import { EMAIL, EMAIL_HREF, TEL_HREF, WA_DISPLAY, waAnchorProps, waLink } from "@/lib/contact";
+import { track } from "@/lib/analytics";
+
+/**
+ * The freight quote flow.
+ *
+ * The site has no backend and no web forms by design: every enquiry ends in a
+ * WhatsApp deep link. So this is a short guided builder rather than something
+ * that submits. It collects the four things every service in the catalogue asks
+ * for — what the cargo is, where it is now, where it needs to go and roughly
+ * when it is ready — then composes a plain message and hands it to WhatsApp.
+ *
+ * Mounting it (for whoever links to it from the nav or the home page):
+ *
+ *   const [quote, setQuote] = useState(false);
+ *   <button onClick={() => setQuote(true)}>Get a freight quote</button>
+ *   <FreightQuoteDialog open={quote} onClose={() => setQuote(false)} source="nav" />
+ *
+ * `service` pre-sets the flow to one service; `initialOrigin`, `initialDestination`
+ * and `initialCargo` pre-set a single answer, e.g. from a lane chip.
+ */
+export interface FreightQuoteDialogProps {
+  open: boolean;
+  onClose: () => void;
+  /** Pre-set the enquiry to one service from the catalogue. */
+  service?: Service | null;
+  /** Pre-selected answers. Anything left out starts empty. */
+  initialCargo?: string;
+  initialOrigin?: string;
+  initialDestination?: string;
+  /** Analytics label for where the dialog was opened from. */
+  source?: string;
+}
+
+/** Deliberately vague: a readiness window, never a promise about a sailing. */
+const READY_OPTIONS = [
+  "Ready now",
+  "Within a month",
+  "In one to three months",
+  "Still planning",
+] as const;
+
+/**
+ * The cargo answer a service already implies. Services that apply to any cargo
+ * (clearance, haulage, insurance) are absent on purpose, so the visitor picks.
+ */
+const CARGO_FOR_SERVICE: Record<string, string> = {
+  "vehicle-shipping": "A vehicle",
+  "ro-ro": "A vehicle",
+  "container-freight": "Container freight",
+  "warehousing-and-consolidation": "Container freight",
+  "plant-and-machinery": "Plant or machinery",
+  "breakbulk-and-project-cargo": "Oversized or project cargo",
+  "personal-effects": "Personal effects",
+};
+
+export function FreightQuoteDialog({
+  open,
+  onClose,
+  service = null,
+  initialCargo,
+  initialOrigin,
+  initialDestination,
+  source = "shipping",
+}: FreightQuoteDialogProps) {
+  const [cargo, setCargo] = useState("");
+  const [origin, setOrigin] = useState("");
+  const [destination, setDestination] = useState("");
+  const [details, setDetails] = useState("");
+  const [ready, setReady] = useState("");
+
+  // Opened from page state rather than a Radix Trigger, so focus has nowhere to
+  // return to on close. Remember the last element focused outside any dialog.
+  const openerRef = useRef<HTMLElement | null>(null);
+  useEffect(() => {
+    const onFocusIn = (e: FocusEvent) => {
+      const t = e.target;
+      if (t instanceof HTMLElement && !t.closest("[role=dialog]")) openerRef.current = t;
+    };
+    document.addEventListener("focusin", onFocusIn);
+    return () => document.removeEventListener("focusin", onFocusIn);
+  }, []);
+
+  // The seed is read through a ref so the reset below can depend on `open`
+  // alone. Depending on the props directly would re-run it whenever a parent
+  // re-rendered with a new `service` object and wipe what the visitor typed.
+  const seedRef = useRef({ service, initialCargo, initialOrigin, initialDestination, source });
+  seedRef.current = { service, initialCargo, initialOrigin, initialDestination, source };
+
+  // Every opening starts a fresh enquiry, seeded with whatever the opener knew.
+  useEffect(() => {
+    if (!open) return;
+    const seed = seedRef.current;
+    setCargo(seed.initialCargo ?? (seed.service ? CARGO_FOR_SERVICE[seed.service.slug] ?? "" : ""));
+    setOrigin(seed.initialOrigin ?? "");
+    setDestination(seed.initialDestination ?? "");
+    setDetails("");
+    setReady("");
+    track("freight_quote_open", { service: seed.service?.slug ?? "none", source: seed.source });
+  }, [open]);
+
+  const message = useMemo(() => {
+    const trimmed = details.trim();
+    return [
+      "Hi LWD Africa, I'd like a freight quote.",
+      service ? `Service: ${service.name}` : null,
+      cargo ? `Cargo: ${cargo}` : null,
+      origin ? `From: ${origin}` : null,
+      destination ? `To: ${destination}` : null,
+      trimmed ? `Details: ${trimmed}` : null,
+      ready ? `Ready: ${ready}` : null,
+      "Please let me know what else you need to quote it.",
+    ]
+      .filter(Boolean)
+      .join("\n");
+  }, [service, cargo, origin, destination, details, ready]);
+
+  const titleId = "freight-quote-title";
+  const descId = "freight-quote-description";
+  const hints = service ? service.needed : null;
+
+  return (
+    <DialogPrimitive.Root open={open} onOpenChange={(o) => { if (!o) onClose(); }}>
+      <DialogPrimitive.Portal>
+        <DialogPrimitive.Overlay className="fixed inset-0 z-[80] bg-background/85 backdrop-blur-md data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0" />
+        <DialogPrimitive.Content
+          aria-labelledby={titleId}
+          aria-describedby={descId}
+          onCloseAutoFocus={(e) => {
+            const opener = openerRef.current;
+            if (opener && document.contains(opener)) {
+              e.preventDefault();
+              opener.focus({ preventScroll: true });
+            }
+          }}
+          className="fixed left-1/2 top-1/2 z-[81] w-[calc(100%-1.5rem)] sm:w-[calc(100%-3rem)] max-w-xl max-h-[92dvh] -translate-x-1/2 -translate-y-1/2 overflow-hidden bg-card border border-border rounded-2xl shadow-2xl flex flex-col focus:outline-none data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95"
+        >
+          <div className="shrink-0 border-b border-border p-5 sm:p-6 flex items-start justify-between gap-4">
+            <div className="min-w-0">
+              <div className="eyebrow">{service ? service.kicker : "Freight quote"}</div>
+              <DialogPrimitive.Title id={titleId} className="font-display text-2xl sm:text-3xl font-semibold mt-2 leading-tight">
+                {service ? service.name : "Tell us what and where"}
+              </DialogPrimitive.Title>
+              <DialogPrimitive.Description id={descId} className="text-xs sm:text-sm text-muted-foreground mt-2 leading-relaxed">
+                Five short answers. We turn them into a WhatsApp message you can read before it sends — nothing is submitted anywhere.
+              </DialogPrimitive.Description>
+            </div>
+            <DialogPrimitive.Close
+              aria-label="Close"
+              className="shrink-0 w-11 h-11 sm:w-9 sm:h-9 rounded-full bg-background border border-border grid place-items-center text-lg hover:bg-[color:var(--surface)] transition focus-visible:outline-2 focus-visible:outline-primary"
+            >×</DialogPrimitive.Close>
+          </div>
+
+          <div className="flex-1 overflow-y-auto overscroll-contain p-5 sm:p-6 space-y-7">
+            {hints ? (
+              <div className="rounded-xl border border-border bg-[color:var(--surface)] p-4">
+                <div className="text-[10px] uppercase tracking-[0.22em] text-primary">What we need to quote</div>
+                <ul className="mt-3 space-y-1.5 text-xs text-muted-foreground leading-relaxed">
+                  {hints.map((h) => (
+                    <li key={h} className="flex gap-2">
+                      <span aria-hidden className="text-primary">·</span>
+                      <span>{h}</span>
+                    </li>
+                  ))}
+                </ul>
+              </div>
+            ) : null}
+
+            <Step n={1} label="What are you shipping?">
+              <div className="flex flex-wrap gap-2">
+                {CARGO_TYPES.map((c) => (
+                  <Chip key={c} label={c} selected={cargo === c} onSelect={() => setCargo(cargo === c ? "" : c)} />
+                ))}
+              </div>
+            </Step>
+
+            <Step n={2} label="Where is it now?">
+              <select
+                aria-label="Origin"
+                value={origin}
+                onChange={(e) => setOrigin(e.target.value)}
+                className="w-full bg-input border border-border rounded-md px-3 py-2.5 min-h-11 md:min-h-0 text-sm"
+              >
+                <option value="">Choose an origin</option>
+                {ORIGIN_REGIONS.map((o) => <option key={o} value={o}>{o}</option>)}
+              </select>
+            </Step>
+
+            <Step n={3} label="Where does it need to go?">
+              <select
+                aria-label="Destination"
+                value={destination}
+                onChange={(e) => setDestination(e.target.value)}
+                className="w-full bg-input border border-border rounded-md px-3 py-2.5 min-h-11 md:min-h-0 text-sm"
+              >
+                <option value="">Choose a destination</option>
+                {DESTINATION_REGIONS.map((d) => <option key={d} value={d}>{d}</option>)}
+              </select>
+            </Step>
+
+            <Step n={4} label="Describe the cargo">
+              <textarea
+                aria-label="Describe the cargo"
+                value={details}
+                onChange={(e) => setDetails(e.target.value)}
+                rows={3}
+                placeholder={
+                  hints
+                    ? `For example: ${hints[0].toLowerCase()}, and the collection and delivery addresses.`
+                    : "What it is, roughly what it weighs or measures, and the collection and delivery addresses."
+                }
+                className="w-full bg-input border border-border rounded-md px-3 py-2.5 text-sm leading-relaxed resize-y"
+              />
+            </Step>
+
+            <Step n={5} label="Roughly when is it ready?">
+              <div className="flex flex-wrap gap-2">
+                {READY_OPTIONS.map((r) => (
+                  <Chip key={r} label={r} selected={ready === r} onSelect={() => setReady(ready === r ? "" : r)} />
+                ))}
+              </div>
+            </Step>
+
+            <div>
+              <div className="text-[10px] uppercase tracking-[0.22em] text-muted-foreground">Your message</div>
+              <p className="mt-3 rounded-xl border border-border bg-[color:var(--surface)] p-4 text-xs leading-relaxed text-muted-foreground whitespace-pre-line">
+                {message}
+              </p>
+            </div>
+          </div>
+
+          <div className="shrink-0 border-t border-border p-4 sm:p-5 space-y-3 bg-card">
+            <div className="grid gap-2 sm:grid-cols-[1.4fr_1fr]">
+              <a
+                href={waLink(message)}
+                {...waAnchorProps}
+                onClick={() => {
+                  track("freight_quote_send", {
+                    service: service?.slug ?? "none",
+                    cargo: cargo || "unspecified",
+                    origin: origin || "unspecified",
+                    destination: destination || "unspecified",
+                    source,
+                  });
+                  track("whatsapp_click", { location: "freight_dialog" });
+                }}
+                className="btn-gold w-full text-center !py-3.5"
+              >
+                <span className="inline-block w-2 h-2 rounded-full whatsapp-dot" aria-hidden />
+                Send on WhatsApp
+              </a>
+              <a
+                href={TEL_HREF}
+                onClick={() => track("call_click", { location: "freight_dialog" })}
+                className="btn-outline w-full text-center !py-3.5"
+              >
+                Call {WA_DISPLAY}
+              </a>
+            </div>
+            <div className="text-[11px] text-muted-foreground text-center">
+              Prefer email?{" "}
+              <a
+                href={EMAIL_HREF}
+                onClick={() => track("email_click", { location: "freight_dialog" })}
+                className="underline hover:text-foreground transition-colors"
+              >{EMAIL}</a>
+            </div>
+          </div>
+        </DialogPrimitive.Content>
+      </DialogPrimitive.Portal>
+    </DialogPrimitive.Root>
+  );
+}
+
+function Step({ n, label, children }: { n: number; label: string; children: ReactNode }) {
+  return (
+    <div>
+      <div className="flex items-baseline gap-3">
+        <span className="text-[10px] uppercase tracking-[0.24em] text-primary">0{n}</span>
+        <span className="text-sm font-semibold">{label}</span>
+      </div>
+      <div className="mt-3">{children}</div>
+    </div>
+  );
+}
+
+function Chip({ label, selected, onSelect }: { label: string; selected: boolean; onSelect: () => void }) {
+  return (
+    <button
+      type="button"
+      aria-pressed={selected}
+      onClick={onSelect}
+      className={`inline-flex items-center justify-center min-h-11 px-3.5 py-2 rounded-sm border text-[11px] uppercase tracking-[0.14em] transition-colors focus-visible:outline-2 focus-visible:outline-primary ${
+        selected
+          ? "border-primary text-primary bg-primary/10 font-semibold"
+          : "border-border text-muted-foreground hover:text-foreground hover:border-primary/60"
+      }`}
+    >
+      {label}
+    </button>
+  );
+}
