# Copy to server/.env and adjust. Values shown are the development defaults.

NODE_ENV=development
PORT=4000

# Where the portal is reached — used in outbound email copy.
APP_URL=http://localhost:5173

# Relative paths resolve against the server package, not the working directory.
DATABASE_FILE=data/portal.db

# REQUIRED in production, minimum 32 characters. The server refuses to start
# without it rather than signing session cookies with a throwaway key.
SESSION_SECRET=

# Session lifetime in hours.
SESSION_TTL_HOURS=12

# Verification codes.
CODE_TTL_MINUTES=15
MAX_CODE_ATTEMPTS=5

# Returns the code in the API response so the flow can be demonstrated without a
# mailbox. Ignored in production, where it is always off.
REVEAL_CODES=true

# Per-IP caps over a 15 minute window.
CODE_REQUEST_LIMIT=6
LOGIN_ATTEMPT_LIMIT=10

# Instagram Graph API token for the public site's live feed (@genesismodelmgmt).
# Optional — with no token the site shows its curated gallery instead. Issue a
# long-lived token from the Meta developer dashboard for the agency account.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_CACHE_MINUTES=10
